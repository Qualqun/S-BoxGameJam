@using Sandbox
@using Sandbox.UI
@using System.Collections.Generic
@using System.Linq
@using System;
@inherits PanelComponent
@namespace Sandbox

<root class="death-rewards">
	<div class="death-title">
		You Died
	</div>

	<div class="death-subtitle">
		Choose a reward to come back stronger!
	</div>

	<div class="rewards">
		@foreach (var power in ActivePowers)
		{
			<div class="reward-card" @onclick=@( () => OnRewardClicked( power ) )>
				<div class="reward-image">
					<Image Texture="@power.Image" />
				</div>

				<div class="reward-title">
					@power.Title
				</div>

				<div class="reward-passive">
					@power.Description
				</div>
			</div>
		}
	</div>
</root>

@code
{
	public List<Power> ActivePowers { get; set; } = new List<Power>();

	protected override void OnStart()
	{
		base.OnStart();
		Panel.AddClass("hidden");
	}

	public void Show()
	{
		GenerateRandomRewards();
		Panel.RemoveClass("hidden");
	}

	public void Hide()
	{
		Panel.AddClass("hidden");
	}

	private void GenerateRandomRewards()
	{
		var allPowers = ResourceLibrary.GetAll<Power>()
			.Where(p => p != null && !string.IsNullOrEmpty(p.Title) && p.Image != null)
			.ToList();

		if (allPowers.Count == 0)
		{
			Log.Warning("Aucun fichier .power valide n'a été trouvé !");
			return;
		}

		Random rng = new Random();
		var shuffledPowers = allPowers.OrderBy(x => rng.Next()).ToList();

		ActivePowers = shuffledPowers.Take(3).ToList();

		foreach (var power in ActivePowers)
		{
			Log.Info($"Power: {power.Title} | Image: {power.Image} | Description: {power.Description}");
		}

		StateHasChanged();
	}

	private void OnRewardClicked(Power selectedPower)
	{
		PlayerState localPlayerState = Scene.GetAllComponents<PlayerState>().FirstOrDefault(p => !p.IsProxy);

		if (localPlayerState != null)
		{
			localPlayerState.ApplyBoost(selectedPower.BoostType);

			Hide();
		}
	}
}
