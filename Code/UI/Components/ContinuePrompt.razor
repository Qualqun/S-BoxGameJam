@using Sandbox
@using Sandbox.UI
@using System.Linq
@inherits PanelComponent
@namespace Sandbox

<root class="continue-prompt">

	<div class="prompt-title">
		One more round?
	</div>

	<div class="choices">

		<div class="choice yes" @onclick=@OnYesClicked>
			YES
		</div>

		<div class="choice no">
			NO
		</div>

	</div>
</root>

@code
{
	protected override void OnStart()
	{
		base.OnStart();

		Panel.AddClass("hidden");
	}

	public void Show()
	{
		Panel.RemoveClass("hidden");
	}

	public void Hide()
	{
		Panel.AddClass("hidden");
	}

	private void OnYesClicked()
	{
		DeathRewards deathRewards = Scene.GetAllComponents<DeathRewards>().FirstOrDefault();

		if (deathRewards != null)
		{
			deathRewards.Show();
			Hide();
		}
		else
		{
			Log.Warning("DeathRewards not found in the scene!");
		}
	}
}
