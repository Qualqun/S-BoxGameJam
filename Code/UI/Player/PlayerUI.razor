@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@using System.Globalization;
@inherits PanelComponent
@namespace Sandbox

<root class="player-ui">
	@if (GameState?.State == GameStateType.Playing)
	{
		<div class="health-panel-container">
			<div class="health-panel">
				<div class="health-bar">
					<div class="health-fill" style="width: @((HealthPercent * 100f).ToString("0.##", CultureInfo.InvariantCulture))%"></div>
				</div>
				<div class="stat-indicator health-indicator">
					<div class="stat-icon hp-icon"></div>
					<div class="lives-counter">
						x@(PlayerState?.Lives ?? 5)
					</div>
				</div>
			</div>

			<div class="xp-panel">
				<div class="xp-bar">
					<div class="xp-fill" style="width: @((XpPercent * 100f).ToString("0.##", CultureInfo.InvariantCulture))%"></div>
				</div>
				<div class="stat-indicator xp-indicator">
					<div class="stat-icon xp-icon"></div>
					<div class="xp-counter">
						x@(PlayerState?.XpMultiplier ?? 1)
					</div>
				</div>
			</div>
		</div>
	}

	@if (ShowWorldArrow && arrowVisible)
	{
		<div class="world-arrow" style="@arrowStyle">
			@if (WorldArrowTexture is not null)
			{
				<div class="world-arrow-image">
					<Image Texture="@WorldArrowTexture" />
				</div>
			}
			else
			{
				<div class="world-arrow-icon"></div>
			}
		</div>
	}

	@if (GameState?.State == GameStateType.Playing)
	{
		@foreach (var notification in xpNotifications)
		{
			@if (notification.Visible)
			{
				<div @key="notification" class="xp-notification @(notification.IsLevelUp ? "level-up" : "")" style="@notification.Style">@notification.Text</div>
			}
		}
	}
</root>

@code
{
	[Property] public GameState GameState { get; set; }
	[Property] public PlayerState PlayerState { get; set; }
	[Property] public float MaxHealth { get; set; } = 100f;
	[Property] public float CurrentHealth { get; set; } = 100f;
	[Property] public bool ShowWorldArrow { get; set; }
	[Property] public Texture WorldArrowTexture { get; set; }
	[Property] public float WorldArrowEdgeMargin { get; set; } = 56f;
	[Property] public float WorldArrowOnScreenOffset { get; set; } = 0f;

	Vector3 arrowWorldPosition;
	bool hasArrowTarget;
	bool arrowVisible;
	string arrowStyle;
	bool hasExperienceSnapshot;
	int previousExperience;
	int previousLevel;

	const float XpNotificationDuration = 1f;
	const float XpNotificationRiseDistance = 56f;
	const float XpNotificationWorldHeight = 80f;
	readonly List<FloatingXpNotification> xpNotifications = new();

	sealed class FloatingXpNotification
	{
		public string Text;
		public bool IsLevelUp;
		public Vector3 WorldPosition;
		public float Age;
		public bool Visible;
		public string Style;
	}

	public float HealthPercent => MaxHealth <= 0f ? 0f : (CurrentHealth / MaxHealth).Clamp(0f, 1f);

	public float XpPercent
	{
		get
		{
			float max = PlayerState?.MaxExperience ?? 100f;
			if (max <= 0f) return 0f;
			float current = PlayerState?.Experience ?? 0f;
			return (current / max).Clamp(0f, 1f);
		}
	}

	public void SetHealth(float currentHealth, float maxHealth)
	{
		CurrentHealth = currentHealth;
		MaxHealth = maxHealth;
		StateHasChanged();
	}

	public void ShowArrowToWorldPosition(Vector3 worldPosition)
	{
		arrowWorldPosition = worldPosition;
		hasArrowTarget = true;
		ShowWorldArrow = true;
	}

	public void HideWorldArrow() => ShowWorldArrow = false;

	/// <summary>
	/// Shows a local-only XP notification. This intentionally has no RPC: PlayerUI exists only for its owner.
	/// </summary>
	public void ShowExperienceNotification(bool levelUp = false)
	{
		xpNotifications.Add(new FloatingXpNotification
		{
			Text = levelUp ? "+LVL UP" : "+XP",
			IsLevelUp = levelUp,
			WorldPosition = GameObject.WorldPosition + Vector3.Up * XpNotificationWorldHeight
		});
	}

	protected override void OnUpdate()
	{
		base.OnUpdate();

		if (!GameState.IsValid())
		{
			GameState = Scene.GetAllComponents<GameState>().FirstOrDefault();
		}

		if (!PlayerState.IsValid())
		{
			PlayerState = Scene.GetAllComponents<PlayerState>()
				.FirstOrDefault(p => !p.IsProxy);
		}

		if (PlayerState.IsValid())
		{
			CurrentHealth = PlayerState.Hp;
			MaxHealth = PlayerState.MaxHp;

			if (!hasExperienceSnapshot)
			{
				previousExperience = PlayerState.Experience;
				previousLevel = PlayerState.XpMultiplier;
				hasExperienceSnapshot = true;
			}
			else
			{
				if (PlayerState.XpMultiplier > previousLevel)
					ShowExperienceNotification(levelUp: true);
				else if (PlayerState.Experience != previousExperience)
					ShowExperienceNotification();

				previousExperience = PlayerState.Experience;
				previousLevel = PlayerState.XpMultiplier;
			}
		}
	}

	protected override void OnPreRender()
	{
		base.OnPreRender();

		UpdateWorldArrow();
		UpdateXpNotifications();
	}

	void UpdateXpNotifications()
	{
		for (int i = xpNotifications.Count - 1; i >= 0; i--)
		{
			FloatingXpNotification notification = xpNotifications[i];
			notification.Age += Time.Delta;

			if (notification.Age >= XpNotificationDuration)
			{
				xpNotifications.RemoveAt(i);
				continue;
			}

			CameraComponent camera = Scene.Camera;
			notification.Visible = camera.IsValid()
				&& Vector3.Dot(notification.WorldPosition - camera.WorldPosition, camera.WorldRotation.Forward) > 0f;

			if (!notification.Visible)
				continue;

			Vector2 screen = camera.PointToScreenNormal(notification.WorldPosition);
			if (!float.IsFinite(screen.x) || !float.IsFinite(screen.y))
			{
				notification.Visible = false;
				continue;
			}

			float progress = notification.Age / XpNotificationDuration;
			float opacity = 1f - ((progress - 0.6f) / 0.4f).Clamp(0f, 1f);
			float rise = XpNotificationRiseDistance * progress;
			notification.Style = FormattableString.Invariant(
				$"left: {screen.x * 100f:0.###}%; top: {screen.y * 100f:0.###}%; margin-top: {-rise:0.###}px; opacity: {opacity:0.###};");
		}

		if (xpNotifications.Count > 0)
			StateHasChanged();
	}

	void UpdateWorldArrow()
	{
		arrowVisible = false;
		if (!ShowWorldArrow || !hasArrowTarget) return;

		CameraComponent camera = Scene.Camera;
		if (!camera.IsValid()) return;

		Vector2 screen = camera.PointToScreenNormal(arrowWorldPosition);
		if (!float.IsFinite(screen.x) || !float.IsFinite(screen.y)) return;

		bool inFront = Vector3.Dot(arrowWorldPosition - camera.WorldPosition, camera.WorldRotation.Forward) > 0f;
		bool onScreen = inFront && screen.x >= 0f && screen.x <= 1f && screen.y >= 0f && screen.y <= 1f;
		Vector2 position = screen;
		Vector2 direction = screen - new Vector2(0.5f, 0.5f);

		if (!inFront) direction = -direction;
		if (direction.LengthSquared < 0.0001f) direction = Vector2.Up;

		if (onScreen)
		{
			Vector2 offset = direction.Normal * WorldArrowOnScreenOffset;
			position.x -= Screen.Width > 0f ? offset.x / Screen.Width : 0f;
			position.y -= Screen.Height > 0f ? offset.y / Screen.Height : 0f;
		}
		else
		{
			Vector2 edge = direction.Normal;
			float scale = MathF.Min(
				edge.x == 0f ? float.MaxValue : 0.5f / MathF.Abs(edge.x),
				edge.y == 0f ? float.MaxValue : 0.5f / MathF.Abs(edge.y)
			);
			position = new Vector2(0.5f, 0.5f) + edge * scale;
		}

		float marginX = Screen.Width > 0f ? (WorldArrowEdgeMargin / Screen.Width).Clamp(0f, 0.45f) : 0f;
		float marginY = Screen.Height > 0f ? (WorldArrowEdgeMargin / Screen.Height).Clamp(0f, 0.45f) : 0f;

		position.x = position.x.Clamp(marginX, 1f - marginX);
		position.y = position.y.Clamp(marginY, 1f - marginY);

		float angle = MathF.Atan2(direction.y, direction.x) * 180f / MathF.PI;
		arrowStyle = string.Format(CultureInfo.InvariantCulture,
			"left: {0:0.###}%; top: {1:0.###}%; transform: translate( -50%, -50% ) rotate( {2:0.###}deg );",
			position.x * 100f, position.y * 100f, angle);

		arrowVisible = true;
	}

	protected override int BuildHash() => HashCode.Combine(
		GameState == null ? 0 : (int)GameState.State,
		PlayerState == null ? 0 : HashCode.Combine(
			PlayerState.Lives,
			PlayerState.Experience,
			PlayerState.MaxExperience,
			PlayerState.XpMultiplier
		),
		HashCode.Combine(
			MathF.Ceiling(CurrentHealth),
			MathF.Ceiling(MaxHealth),
			ShowWorldArrow,
			arrowVisible,
			arrowStyle
		)
	);

	protected override void OnDisabled()
	{
		xpNotifications.Clear();
		hasExperienceSnapshot = false;
		base.OnDisabled();
	}
}
